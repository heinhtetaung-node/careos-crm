# public uri
VITE_QFLOW_URI=https://staging-rc-website.rabbitinternet.com/

VITE_ENV=staging
VITE_API_ENDPOINT=https://staging-crm.sabye-songkran.com
VITE_GATEWAY_ENDPOINT=https://staging-crm.sabye-songkran.com/api/bff
VITE_KRATOS_URL=https://staging-crm.sabye-songkran.com/.ory/kratos
VITE_RECOVERY_URL=https://staging-crm.sabye-songkran.com/api/bff/api/{user}/recovery
INLINE_RUNTIME_CHUNK=false
VITE_GO_GATEWAY_ENDPOINT=https://staging-crm.sabye-songkran.com/api/gff

# Feature Flags
VITE_HEALTH_REVAMP=false
VITE_REBRANDING=false
VITE_HIDE_AGENT_ADD_LEAD_BUTTON=true
VITE_HIDE_TEAMS_INSURER_FILTER=true
VITE_CUSTOMER_INFORMATION=false
VITE_WEBSOCKET_ENABLED=true
VITE_SHOW_QUOTATION_HISTORY=true
VITE_SHOW_SUB_MODEL_YEAR_IMPORT=true

# Websocket subscription
VITE_SOCKET_ENDPOINT=wss://staging-crm.sabye-songkran.com/api/pushedli

# Lint flags
DISABLE_ESLINT_PLUGIN=true
ESLINT_NO_DEV_ERRORS=true

# freshdesk email address
VITE_FRESHDESK_EMAIL=support@rabbit-staging.freshdesk.com

# FlagSmith config
