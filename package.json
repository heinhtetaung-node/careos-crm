{
  "name": "careos-crm",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.6",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.2.0"
  },
  "description": "Sales CRM frontend used by staff to manage leads and orders",
  "author": "Rabbit Internet Company Limited",
  "license": "UNLICENSED",
  "scripts": {
    "packages:build": "pnpm --filter \"./packages/*\" -r run build",
    "predev": "pnpm packages:build",
    "prebuild": "pnpm packages:build",
    "prebuild:dev": "pnpm packages:build",
    "prebuild:staging": "pnpm packages:build",
    "prebuild:preprod": "pnpm packages:build",
    "prebuild:prod": "pnpm packages:build",
    "pretest": "pnpm packages:build",
    "dev": "vite",
    "build": "tsc --project tsconfig.build.json && vite build",
    "serve": "vite preview",
    "build:dev": "tsc --project tsconfig.build.json && vite build --mode example",
    "build:staging": "tsc --project tsconfig.build.json && vite build --mode staging",
    "build:preprod": "tsc --project tsconfig.build.json && vite build --mode preprod",
    "build:prod": "tsc --project tsconfig.build.json && vite build --mode production",
    "format:check": "tsc && prettier --check .",
    "format:check-error": "prettier --check . --loglevel error",
    "format:write": "prettier --write .",
    "lint": "pnpm lint:js src",
    "lint:js": "eslint -c .eslintrc.js --cache --cache-location=.cache/eslint --ext .js,.jsx,.ts,.tsx --report-unused-disable-directives",
    "lint:fix": "pnpm lint:js src --fix",
    "lint:check-error": "pnpm lint:js src --quiet",
    "test": "TZ=Asia/Bangkok jest",
    "test:watch": "jest --watchAll --verbose",
    "test:dev": "jest",
    "test:coverage": "TZ=Asia/Bangkok jest --coverage",
    "lint-staged": "lint-staged"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 10",
    "not op_mini all"
  ],
  "dependencies": {
    "@alphafounders/icons": "workspace:*",
