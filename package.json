  },
  "msw": {
    "workerDirectory": "public"
  },
  "pnpm": {
    "overrides": {
      "semver@>=7.0.0 <7.5.2": ">=7.5.2",
      "glob-parent@<5.1.2": ">=5.1.2",
      "nth-check@<2.0.1": ">=2.0.1",
      "postcss@<8.4.31": ">=8.4.31",
      "phin": ">=3.7.1"
    },
    "packageExtensions": {
      "flagsmith": {
        "peerDependencies": {
          "react": "18.3.1",
          "react-dom": "18.3.1"
        }
      }
    }
  }
