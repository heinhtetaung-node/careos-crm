{
  "name": "@alphafounders/icons",
  "version": "0.1.9",
  "main": "./dist",
  "module": "./dist",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist/**"
  ],
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "splitting": false,
    "sourcemap": true,
    "clean": false,
    "onSuccess": "pnpm run gen-types"
  },
  "scripts": {
    "build": "tsup --format esm,cjs --external react",
    "dev": "tsup --format esm,cjs --watch --external react",
    "gen-types": "tsc --declaration --emitDeclarationOnly",
    "lint": "TIMING=1 eslint ./src/**/*.ts*",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "test": "jest",
    "test:coverage": "jest"
  },
  "dependencies": {
    "@alphafounders/tailwind-config": "workspace:*",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.2.2"
  },
  "devDependencies": {
    "@swc/core": "^1.4.13",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "16.0.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.12",
    "@types/lodash": "4.17.0",
    "@types/node": "^20.12.7",
    "@types/react": "18.3.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-sonar-reporter": "^2.0.0",
    "lodash": "^4.17.21",
    "ts-jest": "^29.1.2",
    "tslib": "^2.6.2",
    "typescript": "~5.4.4"
  },
  "peerDependencies": {
    "react": "^17.0.2 || ^18.2.0",
    "react-dom": "^17.0.2 || ^18.2.0"
  },
  "author": "Rabbit Internet Company Limited",
  "license": "UNLICENSED"
}
