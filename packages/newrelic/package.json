{
  "name": "@careos/newrelic",
  "version": "1.0.0",
  "description": "Encapsulating New Relic and offering auxiliary hooks and methods for React",
  "main": "./dist",
  "module": "./dist",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup --format esm,cjs",
    "dev": "tsup --format esm,cjs --watch",
    "gen-types": "tsc --declaration --emitDeclarationOnly",
    "format:check": "tsc && prettier --check .",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.4.5",
    "@testing-library/react": "16.0.0",
    "@types/jest": "29.5.12",
    "@types/new-relic-browser": "^1.230.4",
    "@types/node": "20.12.12",
    "jest": "29.7.0",
    "jest-sonar-reporter": "2.0.0",
    "ts-jest": "29.1.4",
    "typescript": "5.4.5"
  },
  "peerDependencies": {
    "react": "^17.0.2 || ^18.2.0 || ^18.3.1",
    "react-dom": "^17.0.2 || ^18.2.0 || ^18.3.1"
  }
}
