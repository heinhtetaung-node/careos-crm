{
  "name": "@careos/sorting-filtering",
  "version": "1.0.1",
  "description": "This repository is being used to sort and filter packages according to insurance type.",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "author": "Rabbit Internet Company Limited",
  "private": true,
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "splitting": false,
    "sourcemap": true,
    "clean": false,
    "onSuccess": "pnpm run gen-types"
  },
  "scripts": {
    "build": "tsup --format esm,cjs",
    "dev": "tsup --format esm,cjs --watch",
    "gen-types": "tsc --declaration --emitDeclarationOnly",
    "test": "jest",
    "test:coverage": "jest"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.17.0",
    "@types/node": "^20.12.7",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "jest-sonar-reporter": "^2.0.0",
    "ts-jest": "^29.1.2",
    "tslib": "^2.6.2",
    "typescript": "~5.4.4"
  },
  "dependencies": {
    "@alphafounders/mock-data": "workspace:*",
    "@careos/utils": "workspace:*",
    "careos-constants": "workspace:*",
    "lodash": "^4.17.21"
  }
}
