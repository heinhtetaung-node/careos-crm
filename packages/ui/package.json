{
  "name": "@alphafounders/ui",
  "version": "0.1.9",
  "main": "./dist",
  "module": "./dist",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    },
    "./index.css": {
      "default": "./dist/index.css"
    }
  },
  "files": [
    "dist/**"
  ],
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "splitting": false,
    "sourcemap": true,
    "clean": false,
    "onSuccess": "pnpm run gen-types"
  },
  "scripts": {
    "build": "tsup --format esm,cjs --external react",
    "dev": "tsup --format esm,cjs --watch --external react",
    "gen-types": "tsc --declaration --emitDeclarationOnly",
    "lint": "TIMING=1 eslint ./src/**/*.ts*",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "test": "jest",
    "test:coverage": "jest"
  },
  "dependencies": {
    "@alphafounders/icons": "workspace:*",
    "@alphafounders/tailwind-config": "workspace:*",
    "@headlessui/react": "2.1.2",
    "clsx": "^2.1.0",
    "downshift": "^8.5.0",
    "i18next": "^23.11.1",
    "moment": "^2.30.1",
    "react-dropzone": "^14.2.3",
    "react-i18next": "^14.1.0",
    "react-tippy": "^1.4.0",
    "react-toastify": "^10.0.5",
    "react-transition-group": "^4.4.5",
    "showdown": "2.1.0",
    "tailwind-merge": "^2.2.2"
  },
  "devDependencies": {
    "@swc/core": "^1.4.13",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "16.0.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.12",
    "@types/lodash": "4.17.0",
    "@types/node": "^20.12.7",
    "@types/react": "18.3.2",
    "@types/react-transition-group": "4.4.10",
    "@types/showdown": "^2.0.6",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-sonar-reporter": "^2.0.0",
    "lodash": "^4.17.21",
    "postcss-import": "^16.1.0",
    "ts-jest": "^29.1.2",
    "tslib": "^2.6.2",
    "typescript": "~5.4.4"
  },
  "peerDependencies": {
    "react": "^17.0.2 || ^18.2.0 || ^18.3.1",
    "react-dom": "^17.0.2 || ^18.2.0 || ^18.3.1"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "description": "Contains all of the common UI components, elements, and assets used across all of our front end projects.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlphaFounders/careos-frontend.git"
  },
  "keywords": [
    "alphafounders",
    "@alphafounders/ui"
  ],
  "author": "Rabbit Internet Company Limited",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/AlphaFounders/careos-frontend/issues"
  },
  "homepage": "https://github.com/AlphaFounders/careos-frontend#readme"
}
